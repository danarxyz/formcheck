# Copy to .env.local (read by Next.js and drizzle-kit), or run scripts/setup-services.sh to fill it in.
# Validated at runtime by src/env.ts.

# Neon connection strings, written by `neon deploy` / `neon env pull` (Singapore region).
# Pooled, used by the app:
DATABASE_URL=
# Direct, used by `pnpm db:migrate` (falls back to DATABASE_URL for a local Postgres):
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# http://localhost:3000 locally; your Vercel URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud Console → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign in.
ALLOWED_EMAILS=
